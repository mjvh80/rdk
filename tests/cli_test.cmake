foreach(option /crash-dump /CRASH-DUMP)
    execute_process(COMMAND "${RDK_EXE}" "${option}" /help
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "/crash-dump" OR
       NOT output MATCHES "rdk: exiting: requested information displayed" OR
       NOT error MATCHES "crash dumps enabled")
        message(FATAL_ERROR "Crash diagnostic option ${option}: result=${result}, ${output}${error}")
    endif()
endforeach()

execute_process(COMMAND "${RDK_EXE}" /p:rdk-test-secret-do-not-log "/input:<unknown>"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "rdk: exiting: invalid /input token sequence")
    message(FATAL_ERROR "Missing specific exit reason: result=${result}, ${output}${error}")
endif()
string(REGEX MATCH "rdk: diagnostic report: ([^\r\n]+)" report_match "${output}")
set(report_path "${CMAKE_MATCH_1}")
if(NOT report_match OR NOT EXISTS "${report_path}")
    message(FATAL_ERROR "Missing persistent diagnostic report: ${output}${error}")
endif()
file(READ "${report_path}" report)
if(NOT report MATCHES "rdk: exiting: invalid /input token sequence" OR
   NOT report MATCHES "exit_code=0x0000000000000001" OR
   report MATCHES "rdk-test-secret|<unknown>|fatal native exception")
    message(FATAL_ERROR "Persistent report is missing the exit reason or logs private arguments")
endif()
file(REMOVE "${report_path}")

foreach(option /latency /LATENCY)
    execute_process(COMMAND "${RDK_EXE}" "${option}" /help
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "/latency" OR output MATCHES "rdk: latency interval=")
        message(FATAL_ERROR "Latency help ${option}: result=${result}, ${output}${error}")
    endif()
endforeach()

foreach(option --startup-delay --char-delay)
    foreach(value -1 4294967296 abc 12ms "")
        execute_process(COMMAND "${RDK_EXE}" "${option}" "${value}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 1 OR NOT error MATCHES "requires an integer")
            message(FATAL_ERROR "${option} '${value}': result=${result}, ${output}${error}")
        endif()
    endforeach()
endforeach()

foreach(option --startup-delay --char-delay --text --input)
    execute_process(COMMAND "${RDK_EXE}" "${option}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "requires a value")
        message(FATAL_ERROR "${option}: result=${result}, ${output}${error}")
    endif()
endforeach()

execute_process(COMMAND "${RDK_EXE}" --startup-delay 0 --char-delay 4294967295 /help
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Valid delay boundaries: result=${result}, ${output}${error}")
endif()
if(NOT output MATCHES "Ctrl[+]Shift[+]F10" OR NOT output MATCHES "Ctrl[+]Shift[+]F11" OR
   NOT output MATCHES "Ctrl[+]Shift[+]F12")
    message(FATAL_ERROR "Help must list local minimize, reconnect, and quit shortcuts: ${output}")
endif()
foreach(option /screen:1,2 /monitors:1,2)
    execute_process(COMMAND "${RDK_EXE}" "${option}" /list:monitor
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "[1-9][0-9]*: [0-9]+x[0-9]+ at")
        message(FATAL_ERROR "Monitor listing with ${option}: result=${result}, ${output}${error}")
    endif()
endforeach()
foreach(option /screen: /screen:abc /screen:-1 /monitors:abc)
    execute_process(COMMAND "${RDK_EXE}" "${option}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "Invalid monitor selection ${option}: result=${result}, ${output}${error}")
    endif()
endforeach()
foreach(sequence "<delay><enter><F1>" "<ESC><tab>hello<<world>" "<delay><delay><enter>" "")
    execute_process(COMMAND "${RDK_EXE}" --input "${sequence}" /help
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Valid startup sequence: result=${result}, ${output}${error}")
    endif()
endforeach()
foreach(sequence "<unknown>" "abc<enter" "<delay:1000>" "<F13>" "<>")
    execute_process(COMMAND "${RDK_EXE}" --input "${sequence}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "invalid /input")
        message(FATAL_ERROR "Invalid startup sequence: result=${result}, ${output}${error}")
    endif()
endforeach()
foreach(first --text --input)
    if(first STREQUAL "--text")
        set(second --input)
    else()
        set(second --text)
    endif()
    execute_process(COMMAND "${RDK_EXE}" "${first}" "hello" "${second}" "<enter>"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "cannot be combined")
        message(FATAL_ERROR "Conflicting startup options: result=${result}, ${output}${error}")
    endif()
endforeach()
execute_process(COMMAND "${RDK_EXE}" --text "<unknown>" /help
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
